)
out_nc = ncpath("tacna_clusters.nc")
safe_to_netcdf(out_ds, out_nc)
print(f"\nSaved: {out_nc}")

centers_csv = ncpath("tacna_cluster_centers.csv")
with safe_open_w(centers_csv, newline="") as f:
